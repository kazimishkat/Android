<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/SoftModernCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtCartMedicineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Napa Extra 500mg" />

            <TextView
                android:id="@+id/txtCartPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/colorRunningTeal"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="৳ 50.00" />
        </LinearLayout>

        <!-- Quantity Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- NEWLY ADDED -->
            <ImageButton
                android:id="@+id/btnDecreaseQty"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Decrease Quantity"
                android:src="@drawable/ic_minus"
                app:tint="@color/colorTextSecondary" />

            <!-- NEWLY ADDED -->
            <EditText
                android:id="@+id/etCartQuantity"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_cyan"
                android:backgroundTint="@color/colorDashboardBg"
                android:gravity="center"
                android:hint="Qty"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:padding="0dp"
                android:imeOptions="actionDone"
                android:selectAllOnFocus="true" />

            <!-- NEWLY ADDED -->
            <ImageButton
                android:id="@+id/btnIncreaseQty"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Increase Quantity"
                android:src="@drawable/ic_plus"
                app:tint="@color/colorRunningTeal" />

            <ImageButton
                android:id="@+id/btnRemoveCartItem"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove Item"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/colorCompletedRed" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>